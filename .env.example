# Optional: start an OpenAI-compatible inference server with LFM3-1.7B.
# In LM Studio, use the exact identifier shown by your local model server.
DUET_MODEL_BASE_URL=http://127.0.0.1:1234/v1
DUET_MODEL_NAME=LFM3-1.7B
# Set only if your inference endpoint requires a key. Never committed or sent to the browser.
DUET_MODEL_API_KEY=
# Bind to loopback by default.
HOST=127.0.0.1
PORT=5173
